# =============================================================================
# Multi-Agent Code Review & Debugging Pipeline - Environment Configuration
# =============================================================================
# Copy this file to '.env' and configure your desired settings.
# NOTE: Deterministic static scanning (Ruff, Bandit, AST analysis) works with
# zero credentials out of the box. AI-assisted analysis and test generation
# require either an OpenAI API key or a local model (e.g. Ollama).
# IMPORTANT: Never commit '.env' containing real secrets to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Cloud AI Provider (OpenAI, Azure, OpenRouter, etc.)
# -----------------------------------------------------------------------------
# Required only for AI-assisted explanations and test generation with OpenAI.
OPENAI_API_KEY=your_openai_api_key_here

# Model identifier to use (default: gpt-4o-mini)
OPENAI_MODEL_NAME=gpt-4o-mini

# Optional: Custom API base URL for proxies or OpenAI-compatible cloud services
# OPENAI_BASE_URL=https://api.openai.com/v1

# -----------------------------------------------------------------------------
# 2. Local AI Models (Ollama, vLLM, LocalAI, LM Studio)
# -----------------------------------------------------------------------------
# To run 100% locally with Ollama (no paid API key required):
# 1. Install Ollama (https://ollama.com) and pull a model: `ollama run llama3`
# 2. Uncomment the following lines:
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL_NAME=llama3

# -----------------------------------------------------------------------------
# 3. GitHub PR Review Integration (Optional)
# -----------------------------------------------------------------------------
# Required only when running the pipeline against remote GitHub Pull Requests.
# In GitHub Actions, secrets.GITHUB_TOKEN is provided automatically.
# GITHUB_TOKEN=ghp_your_github_personal_access_token_here

# -----------------------------------------------------------------------------
# 4. Runtime & Timeout Settings
# -----------------------------------------------------------------------------
# Request timeout in seconds for LLM API calls (Default: 30)
LLM_TIMEOUT=30
